{
  "name": "元气训练打卡",
  "short_name": "训练打卡",
  "description": "居家训练、专项进阶和状态记录的个人打卡 App。",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
